<jasperReport name="ResporteVentasMes" language="java" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="91b28d57-8212-4ee9-94a8-06d5f2f85873">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="OracleAutos"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<parameter name="MES" class="java.lang.Integer"/>
	<query language="sql"><![CDATA[SELECT
    v.ID_Venta,
    v.Fecha_Venta,
    m.Nombre_Modelo,
    v.Forma_Pago,
    v.Precio_Final,
    v.ID_Empleado,
    CalcularComision(v.Precio_Final) AS Comision
FROM Ventas v,
     Vehiculos vh,
     Modelos m
WHERE v.ID_Vehiculo = vh.ID_Vehiculo
  AND vh.ID_Modelo = m.ID_Modelo
  AND EXTRACT(MONTH FROM v.Fecha_Venta) = $P{MES}
ORDER BY v.Fecha_Venta]]></query>
	<field name="ID_VENTA" class="java.math.BigDecimal">
		<property name="com.jaspersoft.studio.field.name" value="ID_VENTA"/>
		<property name="com.jaspersoft.studio.field.label" value="ID_VENTA"/>
	</field>
	<field name="FECHA_VENTA" class="java.sql.Timestamp">
		<property name="com.jaspersoft.studio.field.name" value="FECHA_VENTA"/>
		<property name="com.jaspersoft.studio.field.label" value="FECHA_VENTA"/>
	</field>
	<field name="NOMBRE_MODELO" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="NOMBRE_MODELO"/>
		<property name="com.jaspersoft.studio.field.label" value="NOMBRE_MODELO"/>
	</field>
	<field name="FORMA_PAGO" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="FORMA_PAGO"/>
		<property name="com.jaspersoft.studio.field.label" value="FORMA_PAGO"/>
	</field>
	<field name="PRECIO_FINAL" class="java.math.BigDecimal">
		<property name="com.jaspersoft.studio.field.name" value="PRECIO_FINAL"/>
		<property name="com.jaspersoft.studio.field.label" value="PRECIO_FINAL"/>
	</field>
	<field name="ID_EMPLEADO" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="ID_EMPLEADO"/>
		<property name="com.jaspersoft.studio.field.label" value="ID_EMPLEADO"/>
	</field>
	<field name="COMISION" class="java.math.BigDecimal">
		<property name="com.jaspersoft.studio.field.name" value="COMISION"/>
		<property name="com.jaspersoft.studio.field.label" value="COMISION"/>
	</field>
	<variable name="TOTAL_VENTAS" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[$F{PRECIO_FINAL}]]></expression>
	</variable>
	<variable name="NOMBRE_MES" class="java.lang.String">
		<expression><![CDATA[$P{MES} == 1 ? "Enero" :
$P{MES} == 2 ? "Febrero" :
$P{MES} == 3 ? "Marzo" :
$P{MES} == 4 ? "Abril" :
$P{MES} == 5 ? "Mayo" :
$P{MES} == 6 ? "Junio" :
$P{MES} == 7 ? "Julio" :
$P{MES} == 8 ? "Agosto" :
$P{MES} == 9 ? "Septiembre" :
$P{MES} == 10 ? "Octubre" :
$P{MES} == 11 ? "Noviembre" :
"Diciembre"]]></expression>
	</variable>
